# Copy to .env (same folder) and fill in. .env is git-ignored; never commit real credentials.

# Local MySQL created with db/create-local-database.sql
DB_URL=jdbc:mysql://localhost:3306/airbnb
DB_USERNAME=airbnb_app
DB_PASSWORD=

# Using the Docker database instead (docker compose up -d db)? Point at port 3307:
# DB_URL=jdbc:mysql://localhost:3307/airbnb

# HS256 signing key, at least 32 characters (e.g. `openssl rand -base64 48`)
JWT_SECRET=

# Create the demo accounts and hotels on first start (local development only)
SEED_DEMO_DATA=true
