# Copy this to .env (optional). Values are baked in at build time.

# Backend base URL, including the /api/v1 context path
REACT_APP_API_URL=http://localhost:8080/api/v1

# Show the demo login hint on the sign-in page. Defaults to true in development and false in
# production builds; set to true for a public demo whose backend runs with SEED_DEMO_DATA=true.
# REACT_APP_SHOW_DEMO_LOGINS=true
